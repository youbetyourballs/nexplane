services:
  backend:
    ports:
      - "0.0.0.0:8000:8000"
    volumes:
      - /home/ec2-user/nexplane-deploy:/mnt/commercial
    environment:
      CORS_ORIGINS: "${DEV_CORS_ORIGINS:?set DEV_CORS_ORIGINS in .env}"
      SECRET_KEY: "${SECRET_KEY:-dev-secret-key-change-in-production-32chars}"
      NEXPLANE_COMMERCIAL_CATALOG_PATH: /mnt/commercial/catalog
    command: >
      sh -c "tailscaled --tun=userspace-networking --state=/var/lib/tailscale-state/tailscaled.state &
             sleep 3 &&
             tailscale up --authkey=${TS_AUTHKEY:?set TS_AUTHKEY in .env} --hostname=nexplane-backend --accept-dns=false --accept-routes &&
             alembic upgrade heads &&
             python seed.py &&
             uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/app --reload-exclude /app/tests --reload-exclude /app/alembic"
  frontend:
    ports:
      - "0.0.0.0:3000:3000"
    environment:
      VITE_API_URL: "${VITE_API_URL:?set VITE_API_URL in .env}"
