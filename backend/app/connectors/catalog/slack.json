      "parameters": [{"name": "target_email", "type": "string", "required": true}],
      "executor": "offboard_user.steps.deactivate_slack",
      "rollback_action": "reinstate_slack_member",
      "estimated_duration_seconds": 5
    },
    {
      "action_id": "reinstate_slack_member",
      "action_type": "change",
      "execution_tier": 1,
      "display_name": "Offboard Rollback: Reactivate Slack Member",
      "description": "Reactivates a Slack user as part of offboard_user rollback",
      "applicable_asset_types": ["identity"],
      "parameters": [{"name": "target_email", "type": "string", "required": true}],
      "executor": "offboard_user.steps.deactivate_slack",
      "estimated_duration_seconds": 5
    },
    {
      "action_id": "verify_slack_disabled",
      "action_type": "verify",
      "execution_tier": 1,
