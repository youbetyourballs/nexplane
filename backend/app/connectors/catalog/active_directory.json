    {
      "action_id": "ad_forest_restore",
      "generic_action": "ad_forest_restore",
      "action_type": "change",
      "execution_tier": 3,
      "display_name": "AD Forest Restore",
      "description": "Restores ntds.dit and SYSVOL from S3 snapshot onto a pre-provisioned clean Windows Server, promotes it as a DC, and cuts over DNS. DESTRUCTIVE \u00e2\u20ac\u201d use only for post-incident recovery.",
      "applicable_asset_types": [
        "server"
      ],
      "parameters": [
        {
          "name": "target_hostname",
          "type": "string",
          "required": true,
          "description": "WinRM-accessible clean Windows Server to restore onto"
        },
        {
          "name": "winrm_username",
          "type": "string",
          "required": true
        },
        {
          "name": "winrm_password",
          "type": "password",
          "required": true
        },
        {
          "name": "winrm_port",
          "type": "integer",
          "required": false,
          "default": 5985
        },
        {
          "name": "winrm_use_ssl",
          "type": "boolean",
          "required": false,
          "default": false
        },
        {
          "name": "snapshot_s3_key",
          "type": "string",
          "required": true,
          "description": "S3 key of the ntds.dit snapshot to restore"
        },
        {
          "name": "s3_bucket",
          "type": "string",
          "required": true,
          "description": "S3 bucket containing the snapshot"
        },
        {
          "name": "domain_name",
          "type": "string",
          "required": true,
          "description": "e.g. corp.example.com"
        },
        {
          "name": "domain_netbios_name",
          "type": "string",
          "required": false,
          "description": "Defaults to first label of domain_name uppercased"
        },
        {
          "name": "safe_mode_password",
          "type": "password",
          "required": true,
          "description": "DSRM password for the restored DC"
        },
        {
          "name": "existing_dc_hostnames",
          "type": "array",
          "required": false,
          "description": "WinRM-checked for reachability; halt if any respond"
        },
        {
          "name": "dns_update_mode",
          "type": "string",
          "required": false,
          "default": "manual",
          "description": "route53 | azure | manual"
        },
        {
          "name": "route53_zone_id",
          "type": "string",
          "required": false,
          "description": "Required if dns_update_mode == route53"
        },
        {
          "name": "azure_zone_name",
          "type": "string",
          "required": false,
          "description": "Required if dns_update_mode == azure"
        },
        {
          "name": "azure_resource_group",
          "type": "string",
          "required": false,
          "description": "Required if dns_update_mode == azure"
        },
        {
          "name": "aws_region",
          "type": "string",
          "required": false,
          "default": "us-east-1"
        }
      ],
      "executor": "active_directory.ad_forest_restore",
      "rollback_action": null,
      "estimated_duration_seconds": 1800,
      "blast_radius_hint": "infrastructure_replacement",
      "safety_notes": [
        "DESTRUCTIVE \u00e2\u20ac\u201d promotes a new DC and cuts over DNS",
        "Operator must pre-provision a clean Windows Server and pass its hostname",
        "Verify all existing DCs are isolated before running (use existing_dc_hostnames to enforce)",
        "This is a post-incident recovery operation, not routine maintenance"
      ]
    },
    {
      "action_id": "ad_dc_decommission",
