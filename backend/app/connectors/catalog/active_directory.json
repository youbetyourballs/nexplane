      "parameters": [
        {
          "name": "source_dc_asset_id",
          "label": "Source DC Asset ID",
          "type": "string",
          "required": true,
          "description": "Asset ID of the DC being replaced; used to look up WinRM hostname and connector"
        },
        {
          "name": "target_windows_version",
          "label": "Target Windows Server Version",
          "type": "string",
          "required": true,
          "enum": ["2022", "2019"],
          "description": "Windows Server version for the new DC"
        },
        {
          "name": "domain_admin_username",
          "label": "Domain Admin Username",
          "type": "string",
          "required": true,
          "description": "Domain admin account for DCPromo and FSMO operations (e.g. CORP\\Administrator)"
        },
        {
          "name": "domain_admin_password",
          "label": "Domain Admin Password",
          "type": "password",
          "required": false,
          "description": "Password; sourced from connector creds winrm_password if absent"
        },
        {
          "name": "new_dc_instance_type",
          "label": "New DC EC2 Instance Type",
          "type": "string",
          "required": false,
          "default": "t3.medium"
        },
        {
          "name": "new_dc_subnet_id",
          "label": "New DC Subnet ID",
