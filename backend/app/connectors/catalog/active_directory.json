        {
          "name": "winrm_password",
          "type": "password",
          "required": false
        },
        {
          "name": "winrm_port",
          "type": "integer",
          "required": false,
          "default": 5985
        }
      ],
      "executor": "active_directory.ad_dc_decommission",
      "rollback_action": null,
      "estimated_duration_seconds": 120,
      "blast_radius_hint": "infrastructure_termination",
      "safety_notes": [
