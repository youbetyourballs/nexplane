{
  "credential_fields": [
    {
      "required": true, 
      "type": "string", 
      "name": "server", 
      "label": "SCCM Server Hostname / IP"
    }, 
    {
      "required": true, 
      "type": "string", 
      "name": "username", 
      "label": "Username (DOMAIN\\user or user@domain)"
    }, 
    {
      "required": true, 
      "type": "password", 
      "name": "password", 
      "label": "Password"
    }, 
    {
      "required": true, 
      "type": "string", 
      "name": "site_code", 
      "label": "Site Code (3-letter, e.g. PS1)"
    }, 
    {
      "default": "false", 
      "required": false, 
      "type": "string", 
      "name": "verify_ssl", 
      "label": "Verify SSL Certificate"
    }, 
    {
      "default": "true", 
      "required": false, 
      "type": "string", 
      "name": "use_ntlm", 
      "label": "Use NTLM Authentication (set false to use Basic Auth)"
    }
  ], 
  "connector_type": "sccm", 
  "display_name": "SCCM / MECM (Microsoft Endpoint Configuration Manager)", 
  "actions": [
    {
      "display_name": "Deploy Application", 
      "description": "Deploys an SCCM application to a device or user collection. Rollback removes the deployment.", 
      "parameters": [
        {
          "required": true, 
          "type": "string", 
          "name": "app_name", 
          "description": "Exact name of the application as registered in SCCM"
        }, 
        {
          "required": true, 
          "type": "string", 
          "name": "collection_id", 
          "description": "Target SCCM collection ID (e.g. SMS00001)"
        }, 
        {
          "default": "Required", 
          "required": false, 
          "type": "string", 
          "name": "deployment_purpose", 
          "description": "Required or Available"
        }
      ], 
      "execution_tier": 3,
      "rollback_action": "sccm_remove_deployment", 
      "estimated_duration_seconds": 30, 
      "blast_radius_hint": "collection_wide", 
      "applicable_asset_types": [
        "server", 
        "endpoint"
      ], 
      "action_type": "change", 
      "executor": "sccm.deploy_application", 
      "generic_action": "sccm_deploy_application", 
      "action_id": "deploy_application"
    }, 
    {
      "display_name": "Remove Application Deployment", 
      "description": "Removes an application deployment from a collection (rollback for deploy_application).", 
      "parameters": [
        {
          "required": true, 
          "type": "string", 
          "name": "deployment_id", 
          "description": "SCCM DeploymentID to remove"
        }
      ], 
      "execution_tier": 3,
      "estimated_duration_seconds": 15,
      "applicable_asset_types": [
        "server",
        "endpoint"
      ],
      "action_type": "change",
      "executor": "sccm.deploy_application",
      "generic_action": "sccm_remove_deployment", 
      "action_id": "remove_deployment"
    }, 
    {
      "display_name": "Run Approved Script", 
      "description": "Runs a pre-approved SCCM script (by GUID) against a collection. Scripts must be approved in the SCCM console \u2014 no freeform execution.", 
      "parameters": [
        {
          "required": true, 
          "type": "string", 
          "name": "script_guid", 
          "description": "GUID of the pre-approved SCCM script"
        }, 
        {
          "required": true, 
          "type": "string", 
          "name": "collection_id", 
          "description": "Target collection ID"
        }
      ], 
      "execution_tier": 3,
      "estimated_duration_seconds": 60, 
      "blast_radius_hint": "collection_wide", 
      "applicable_asset_types": [
        "server", 
        "endpoint"
      ], 
      "action_type": "change", 
      "executor": "sccm.run_script", 
      "safety_notes": [
        "Only scripts pre-approved in the SCCM console can be executed \u2014 no freeform PowerShell permitted"
      ], 
      "generic_action": "sccm_run_script", 
      "action_id": "run_script"
    }, 
    {
      "display_name": "Collect Software Inventory", 
      "description": "Pulls hardware and software inventory for a specific device from SCCM. Read-only.", 
      "parameters": [
        {
          "required": true, 
          "type": "string", 
          "name": "device_name", 
          "description": "NetBIOS name of the device as registered in SCCM"
        }
      ], 
      "execution_tier": 3,
      "estimated_duration_seconds": 15,
      "applicable_asset_types": [
        "server",
        "endpoint"
      ],
      "action_type": "read", 
      "executor": "sccm.collect_inventory", 
      "generic_action": "sccm_collect_inventory", 
      "action_id": "collect_inventory"
    }, 
    {
      "display_name": "Trigger Client Action", 
      "description": "Triggers a client policy action on all devices in a collection (e.g. MachinePolicyRetrieve, HardwareInventory).", 
      "parameters": [
        {
          "required": true, 
          "type": "string", 
          "name": "collection_id", 
          "description": "Target collection ID"
        }, 
        {
          "required": true, 
          "type": "string", 
          "name": "action", 
          "description": "MachinePolicyRetrieve | SoftwareInventory | HardwareInventory | UpdateDeploymentReEval"
        }
      ], 
      "execution_tier": 3,
      "estimated_duration_seconds": 10, 
      "applicable_asset_types": [
        "server", 
        "endpoint"
      ], 
      "action_type": "change", 
      "executor": "sccm.trigger_client_action", 
      "generic_action": "sccm_trigger_client_action", 
      "action_id": "trigger_client_action"
    }
  ]
}