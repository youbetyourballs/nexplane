{
  "connector_type": "jfrog",
  "display_name": "JFrog Xray",
  "credentials": [
    {"name": "url", "label": "JFrog Platform URL", "type": "text", "required": true, "default": "https://yourcompany.jfrog.io"},
    {"name": "user", "label": "Username", "type": "text", "required": true},
    {"name": "token", "label": "API Token", "type": "password", "required": true}
  ],
  "actions": [
    {
      "action_id": "jfrog_scan_artifact",
      "generic_action": "jfrog_scan_artifact",
      "display_name": "Scan Artifact for Vulnerabilities",
      "description": "Triggers an Xray security scan on a specific artifact and returns violations/CVEs.",
      "executor": "jfrog.scan_artifact",
      "action_type": "change",
      "execution_tier": 1,
      "estimated_duration_seconds": 60,
      "applicable_asset_types": ["server", "container_image"],
      "parameters": [
        {"name": "repo", "type": "string", "required": true, "description": "Repository key in Artifactory"},
        {"name": "path", "type": "string", "required": true, "description": "Artifact path within the repository"}
      ]
    },
    {
      "action_id": "jfrog_sync_violations",
      "generic_action": "jfrog_sync_violations",
      "display_name": "Sync Xray Violations as Findings",
      "description": "Pulls all current Xray policy violations and imports them as Nexplane vulnerability findings.",
      "executor": "jfrog.sync_violations",
      "action_type": "change",
      "execution_tier": 1,
      "estimated_duration_seconds": 30,
      "applicable_asset_types": ["server"],
      "parameters": [
        {"name": "repo", "type": "string", "required": false, "description": "Filter violations to a specific repository (optional)"}
      ]
    }
  ]
}
