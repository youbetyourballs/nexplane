# Nexplane — self-hosted configuration
# Copy this file to .env and fill in your values before running docker compose.
# Never commit your .env file to source control.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=nexplane
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nexplane

# ── Application ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-32-char-hex-string

# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ORIGINS=https://nexplane.yourdomain.com

# Public URL of the API (used by frontend to make API calls)
NEXPLANE_API_URL=https://nexplane.yourdomain.com

# ── Nexplane Agent Downloads ─────────────────────────────────────────────────
# Leave default unless you self-host agent binaries
NEXPLANE_AGENT_DOWNLOAD_URL=https://nexplane-agent-downloads.s3.us-east-1.amazonaws.com

# ── Email (optional — enables alert notifications) ───────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Nexplane Alerts <alerts@yourdomain.com>
